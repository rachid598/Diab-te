{
  "appId": "io.github.rachid598.glucovision",
  "appName": "GlucoVision",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#060910"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK",
      "hidden": false
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "appReadyTimeout": 20000,
      "statsUrl": ""
    }
  }
}
